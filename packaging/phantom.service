[Unit]
Description=Phantom Browser Linux agent control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phantom
Group=phantom
Environment=PHANTOM_DATA_DIR=/var/lib/phantom
Environment=PHANTOM_BIND=127.0.0.1
Environment=PHANTOM_PORT=5100
Environment=DISPLAY=:99
EnvironmentFile=-/etc/phantom/phantom.env
StateDirectory=phantom
RuntimeDirectory=phantom
UMask=0077
ExecStart=/usr/local/bin/phantom-linux
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/phantom
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
