{
  "name": "phantom-browser",
  "version": "0.4.11",
  "productName": "Phantom Browser",
  "homepage": "https://github.com/t01101011/phantom-browser",
  "private": true,
  "description": "Phantom Browser — AI-native antidetect browser with persistent Chromium profiles, MCP server, and per-profile proxy/fingerprint",
  "repository": {
    "type": "git",
    "url": "https://github.com/t01101011/phantom-browser.git"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @multizen/desktop dev",
    "build": "yarn workspaces foreach -A run build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "yarn workspaces foreach -A run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,astro}\"",
    "coverage:native": "node scripts/native-coverage/run.mjs",
    "coverage:native:test": "node --test scripts/native-coverage/*.test.mjs",
    "test": "node --test --experimental-strip-types apps/desktop/src/main/*.test.ts apps/desktop/src/renderer/src/lib/*.test.ts packages/cdp-driver/src/*.test.ts packages/profile-manager/scripts/*.test.ts scripts/native-coverage/*.test.mjs",
    "mcp:dev": "yarn workspace @multizen/mcp-server dev",
    "clean": "rm -rf apps/*/dist apps/*/out packages/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
