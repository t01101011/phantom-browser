{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phantom Browser",
  "version": "0.1.0",
  "identifier": "com.tk.phantombrowser",
  "mainBinaryName": "Phantom Browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phantom Browser",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../dist/phantom-sidecar": "phantom-sidecar"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Self-hosted antidetect browser profile manager",
    "longDescription": "Phantom Browser — manage persistent-fingerprint browser profiles with proxy + cookie/session per profile."
  }
}
